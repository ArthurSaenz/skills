{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "ts-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "eslint-check": {
      "dependsOn": ["^build"]
    },
    "eslint-fix": {
      "dependsOn": ["^build"]
    },
    "prettier-check": {},
    "prettier-fix": {}
  }
}
